* C:\Users\HP\Desktop\ee463-hardware-project\Ltspice\UCC27282_gate_test.asc
XXDRV LI HI EN VDD VSS HB HO HS LO UCC27282
.include UCC27282_LTspice.lib
.param Rg=4.7
V12 VIN12 0 DC 12
RSUP VIN12 VDD 0.5
CVDD VDD 0 1u
V_EN EN 0 DC 3.3
V_HI HI 0 PULSE(0 3.3 2.15u 10n 10n 2.35u 10u)
V_LI LI 0 PULSE(3.3 0 2u 10n 10n 2.65u 10u)
V_HS HS 0 DC 0
V_VSS VSS 0 DC 0
CBOOT HB HS 470n
RBOOTLEAK HB HS 1Meg
R_HG HO GH {Rg}
R_LG LO GL {Rg}
C_HG GH HS 10n
C_LG GL 0 10n
R_HGS GH HS 10k
R_LGS GL 0 10k
.tran 0 60u 0 2n
.save V(HI) V(LI) V(EN) V(HO,HS) V(LO) V(GH,HS) V(GL) V(HB,HS) V(VDD)
.backanno
.end
