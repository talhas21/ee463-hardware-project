* UCC27282 - LTspice syntax adaptation of Texas Instruments PSpice transient model
* Original: Texas Instruments, 2018, Model Version Final 1.0, PSpice 16.2.
* Derived from user-provided unencrypted TI model; retains original behavior/topology.
* ONLY syntax changes: VALUE behavioral E/G -> B, nested parameter braces normalized,
* trailing empty PARAMS: removed, unused helper subcircuits omitted.
* NOT verified in an actual LTspice runtime. For engineering evaluation only.
* IMPORTANT: subckt has 9 logical pins incl. EN; SOIC-8 hardware has no EN.
* Subckt order: LI HI EN VDD VSS HB HO HS LO

.model NMOS01 nmos
+ vto=2
+ kp=0.55
+ lambda=0.001

.model PMOS01 pmos
+ vto=-2
+ kp=0.772
+ lambda=0.001

.SUBCKT UCC27282 LI HI EN VDD VSS HB  HO HS  LO
B_U1_E2 HO U1_N16706734 V=IF(V(U1_N16706930, 0) > 0.5, -5, 5)
R_U1_R9         U1_N16707490 U1_N16707354  50
V_U1_V10         U1_N16706152 0 0.5
X_U1_U15         EN U1_N16711349 U1_N16711355 U1_N16713299 COMPHYS_BASIC_GEN VDD=1 VSS=0 VTHRESH=0.5
E_U1_E6         U1_HI_ON VSS U1_N16708422 VSS 1
B_U1_E1 U1_N16707534 U1_HOH V=IF(V(U1_HI_ON, 0) > 0.5, 5, -5)
X_U1_U16         U1_N16712773 U1_N16713299 U1_N16707820 AND2_BASIC_GEN VDD=1 VSS=0 VTHRESH=.5
X_U1_U4         U1_N16706536 U1_UVLOHI U1_N16708416 AND2_BASIC_GEN VDD=1 VSS=0 VTHRESH=.5
C_U1_C6         HO U1_N16706748  7.5p
X_U1_U5         HI U1_N16706446 U1_N16706474 U1_N16706240 COMPHYS_BASIC_GEN VDD=1 VSS=0 VTHRESH=0.5
E_U1_E7         U1_N16708078 VSS HB HS 1
M_U1_M1         U1_N16707574 U1_N16707548 U1_HOH U1_HOH NMOS01
C_U1_C7         U1_N16707366 U1_N16707354  12.5p
R_U1_R11         U1_HOH HO  1m
X_U1_U7         U1_HI_ON U1_N16706930 falling_delay DELAY=1n VDD=1 VSS=0 VTHRESH=0.5
R_U1_R10         U1_N16707366 VSS  0.02
V_U1_V3         U1_N16706446 VSS 2.1
C_U1_C1         U1_N16707548 U1_N16707574  20p
E_U1_E5         U1_LO_ON VSS U1_N16708190 VSS 1
X_U1_U11         U1_N16708416 U1_N16708422 BUFFER_PS VHI=1 VLO=0 VTHRESH=500E-3 TPLH={Thplh} TPHL={Thphl} TR=1E-9 TF=1E-9
X_U1_U6         VDD HB d_d1 
***X_U1_U6         0 0  d_d1 PARAMS:
V_U1_V4         U1_N16706474 0 1
C_U1_C3         U1_HOH U1_N16707548  5p
C_U1_C8         LO U1_N16707354  7.5p
R_U1_R4         HB U1_N16707574  0.02
X_U1_U17         U1_N16706240 U1_LOCK U1_N16707820 U1_UVLOHI AND3_BASIC_GEN VDD=1 VSS=0 VTHRESH=500E-3
X_U1_U12         U1_UVLOLOW U1_N16708190 BUFFER_PS VHI=1 VLO=0 VTHRESH=500E-3 TPLH={Tlplh} TPHL={Tlphl} TR=1E-9 TF=1E-9
B_U1_E4 U1_N16707138 U1_LOH V=IF(V(U1_LO_ON, 0) > 0.5, 5, -5)
R_U1_R7         U1_N16707138 U1_N16707192  50
R_U1_R12         U1_LOH LO  1m
M_U1_M4         U1_N16707366 U1_N16707354 LO LO PMOS01
M_U1_M2         U1_N16706782 U1_N16706748 HO HO PMOS01
R_U1_R2         VSS HI  250k
V_U1_V11         U1_N16711349 VSS 1.8
R_U1_R5         U1_N16706734 U1_N16706748  50
X_U1_U13         HB U1_N16708226 U1_N16708274 U1_N16706536 COMPHYS_BASIC_GEN VDD=1 VSS=0 VTHRESH=0.5
M_U1_M3         U1_N16707204 U1_N16707192 U1_LOH U1_LOH NMOS01
V_U1_V1         U1_N16706306 VSS 2.1
X_U1_U9         U1_N16708078 U1_N16707998 U1_N16708046 N16718557 COMPHYS_BASIC_GEN VDD=1 VSS=0 VTHRESH=0.5
X_U1_U8         U1_LO_ON U1_N16707522 falling_delay DELAY=1n VDD=1 VSS=0 VTHRESH=0.5
V_U1_V12         U1_N16711355 0 0.4
C_U1_C4         U1_N16707192 U1_N16707204  20p
V_U1_V7         U1_N16708226 0 3.7
B_U1_E3 LO U1_N16707490 V=IF(V(U1_N16707522, 0) > 0.5, -5, 5)
C_U1_C2         U1_N16706782 U1_N16706748  12.5p
X_U1_U14         VDD U1_N16706124 U1_N16706152 U1_N16712773 COMPHYS_BASIC_GEN VDD=1 VSS=0 VTHRESH=0.5
V_U1_V2         U1_N16706332 0 1
V_U1_V5         U1_N16707998 0 3.55
C_U1_C5         U1_LOH U1_N16707192  5p
R_U1_R13         VSS EN  200k
V_U1_V8         U1_N16708274 0 0.4
R_U1_R6         U1_N16706782 HS  0.02
X_U1_U10         LI U1_N16706306 U1_N16706332 U1_N16706526 COMPHYS_BASIC_GEN VDD=1 VSS=0 VTHRESH=0.5
X_U1_U20         HI LI U1_LOCK NAND2_BASIC_GEN VDD=1 VSS=0 VTHRESH=500E-3
R_U1_R8         VDD U1_N16707204  0.02
V_U1_V6         U1_N16708046 0 0.1
R_U1_R1         VSS LI  250k
V_U1_V9         U1_N16706124 VSS 5
R_U1_R3         U1_N16707534 U1_N16707548  50
X_U1_U18         U1_N16707820 U1_LOCK U1_N16706526 U1_UVLOLOW AND3_BASIC_GEN VDD=1 VSS=0 VTHRESH=500E-3
.PARAM  thplh=10n tlphl=8.2n thphl=8n tlplh=10.5n
.ends UCC27282

.SUBCKT COMPHYS_BASIC_GEN INP INM HYS OUT PARAMS: VDD=1 VSS=0 VTHRESH=0.5
EIN INP1 INM1 INP INM 1
BHYS INP1 INP2 V=IF( V(1) > VTHRESH,-V(HYS),0)
BOUT OUT 0 V=IF( V(INP2)>V(INM1), VDD ,VSS)
R1 OUT 1 1
C1 1 0 5.0n
RINP1 INP1 0 1K
.ENDS COMPHYS_BASIC_GEN

.SUBCKT AND2_BASIC_GEN A B Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5
B_ABMGATE YINT 0 V=IF(V(A) > VTHRESH  & V(B) > VTHRESH,VDD,VSS)
RINT YINT Y 1
CINT Y 0 1n
.ENDS AND2_BASIC_GEN

.SUBCKT AND3_BASIC_GEN A B C Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5
B_ABMGATE YINT 0 V=IF(V(A) > VTHRESH  & V(B) > VTHRESH & V(C) > VTHRESH,VDD,VSS)
RINT YINT Y 1
CINT Y 0 1n
.ENDS AND3_BASIC_GEN

.SUBCKT NAND2_BASIC_GEN A B Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5
B_ABMGATE YINT 0 V=IF(V(A) > VTHRESH  & V(B) > VTHRESH,VSS,VDD)
RINT YINT Y 1
CINT Y 0 1n
.ENDS NAND2_BASIC_GEN

.subckt falling_delay in out params: delay=100n vdd=1 vss=0 vthresh=0.5
x_u1         int out buf_basic_gen vdd={vdd} vss={vss} vthresh= {vthresh}
r_r1         in int  {delay/(0.693 * 1e-9)}
c_c1         0 int  1n
d_d1         in int dd
.model dd d is=1e-015 n=1 tt=1e-011
.ends falling_delay

.SUBCKT BUF_BASIC_GEN A  Y PARAMS: VDD=1 VSS=0 VTHRESH=0.5
B_ABMGATE YINT 0 V=IF(V(A) > VTHRESH , VDD,VSS)
RINT YINT Y 1
CINT Y 0 1n
.ENDS BUF_BASIC_GEN

.SUBCKT BUFFER_PS A Y PARAMS: vhi=1 vlo=0 vthresh=500e-3 tplh=1e-9 tphl=1e-9 tr=1e-9 tf=1e-9
RA A 0 1e11
CA A 0 0.01pF
VS VSUP 0 DC 1
BBUF1 Ypp 0 V=IF(V(A) > (vthresh), 1, 0)
ROUTpp Ypp 0 1e11
XNSW1 OUTp Ypp 0 NSW_PS RONval={(tplh+1e-15)/(1e-12*0.693)} VTHval=0.5
XPSW1 OUTp Ypp VSUP PSW_PS RONval={(tphl+1e-15)/(1e-12*0.693)} VTHval=0.5
CDEL1 OUTp 0 1pF
BTHRESH Yp 0 V=IF(V(OUTp) > 0.5, 1, 0)
ROUTp Yp 0 1e11
XNSW2 OUTr Yp 0 NSW_PS RONval={(tf+1e-15)/(1e-12*2.3)} VTHval=0.5
XPSW2 OUTr Yp VSUP PSW_PS RONval={(tr+1e-15)/(1e-12*2.3)} VTHval=0.5
CDEL2 OUTr 0 1pF
BOUT OUTf 0 V=V(OUTr)*(vhi - vlo)+vlo
RDR OUTf Y  1000
RO Y 0 1e11
.ENDS BUFFER_PS

.SUBCKT NSW_PS D G S PARAMS: RONval=10k VTHval=0.7 VCHARval=0.01 CGval=0.01pF CDval=0.01pF CSval=0.01pf
RDDUM D 0 1e11
RSDUM S 0 1e11
RGDUM G 0 1e11
CG G D {CGval}
CD D S {CDval}
CS G S {CSval}
***EEXP F1 0 VALUE={LIMIT(((V(G,S)-VTHval)/VCHARval),-80,80)}
Btest test 0 V=IF(V(D) > V(S), V(G,S), V(G,D))
BOUT D S I=V(D,S)/(RONval*(1+EXP(-LIMIT(((V(test)-VTHval)/VCHARval),-80,80))))
.ENDS NSW_PS

.SUBCKT PSW_PS D G S PARAMS: RONval=10k VTHval=0.7 VCHARval=0.01 CGval=0.01pF CDval=0.01pF
RDDUM D 0 1e11
RSDUM S 0 1e11
RGDUM G 0 1e11
CG G D {CGval}
CD D S {CDval}
Btest test 0 V=IF(V(S) > V(D), V(S,G), V(D,G))
BOUT S D I=V(S,D)/(RONval*(1+EXP(-LIMIT(((V(test)-VTHval)/VCHARval),-80,80))))
.ENDS PSW_PS

.subckt d_d1 1 2
d1 1 2 dd1
.model dd1 d is=1e-015 tt=1e-011 rs=0.05 n=1
.ends d_d1
